      },
      {
        "name": "Ammunition dumping 02 - selection",
        "steps": [
          {
            "keyword": "Given",
            "text": "LT slot 1 holds weapon A ammo LT slot 2 holds weapon B ammo and RT slot 1 holds weapon A ammo"
          },
          {
            "keyword": "And",
