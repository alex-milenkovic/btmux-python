          },
          {
            "keyword": "And",
            "text": "the engine advances 1 second"
          },
          {
            "keyword": "Then",
            "text": "LT slot 1 contains <left_a> LT slot 2 contains <left_b> and RT slot 1 contains <right_a> rounds",
            "parameters": [
              "left_a",
              "left_b",
              "right_a"
            ]
          }
        ],
        "columns": [
          "selector",
          "left_a",
          "left_b",
          "right_a"
        ]
      },
      {
        "name": "Ammunition dumping 03 - lifecycle",
        "steps": [
          {
            "keyword": "Given",
