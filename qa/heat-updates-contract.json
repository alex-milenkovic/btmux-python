  "dumping": {
    "background": [
      {
        "keyword": "Given",
        "text": "a fresh heat session with standard ready units and independent clocks"
      }
    ],
    "scenarios": [
      {
        "name": "Ammunition dumping 01 - rate and clock phase",
        "steps": [
          {
            "keyword": "Given",
            "text": "a functional bin with <rounds> rounds of ammunition rated <per_ton> rounds per ton",
            "parameters": [
              "rounds",
              "per_ton"
            ]
          },
          {
            "keyword": "And",
            "text": "the event clock starts at <start_tick>",
            "parameters": [
              "start_tick"
            ]
          },
          {
            "keyword": "When",
            "text": "the pilot requests dump selector all"
          },
          {
            "keyword": "And",
            "text": "the engine advances <seconds> seconds",
            "parameters": [
              "seconds"
            ]
          },
          {
            "keyword": "Then",
            "text": "the bin contains <remaining> rounds and dumping is <pending>",
            "parameters": [
              "remaining",
              "pending"
            ]
          }
        ],
        "columns": [
          "rounds",
          "per_ton",
          "start_tick",
          "seconds",
          "remaining",
          "pending"
