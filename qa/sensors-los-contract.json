{
  "contacts": {
    "background": [
      {
        "keyword": "Given",
        "text": "a fresh sensor session with ready units and event time zero"
      }
    ],
    "scenarios": [
      {
        "name": "Contact readout 01 - packed preferences",
        "steps": [
          {
            "keyword": "Given",
            "text": "contact brief value <initial>",
            "parameters": [
              "initial"
            ]
          },
          {
            "keyword": "When",
            "text": "the pilot issues brief <request>",
            "parameters": [
              "request"
            ]
          },
          {
            "keyword": "Then",
            "text": "the command is <accepted> and brief value is <value>",
            "parameters": [
              "accepted",
              "value"
            ]
          }
        ],
        "columns": [
          "initial",
          "request",
          "accepted",
          "value"
        ]
      },
      {
        "name": "Contact readout 02 - filters",
        "steps": [
          {
            "keyword": "Given",
            "text": "identified contacts friend f enemy e shutdown enemy s destroyed enemy d and locked shutdown enemy t"
          },
          {
            "keyword": "And",
            "text": "contact brevity is 2 with no buildings"
          },
          {
            "keyword": "When",
            "text": "the pilot requests contacts with filter <filter>",
            "parameters": [
              "filter"
            ]
          },
          {
            "keyword": "Then",
            "text": "the included unit IDs as an unordered set are <ids>",
            "parameters": [
              "ids"
            ]
          }
        ],
        "columns": [
          "filter",
          "ids"
        ]
      },
      {
        "name": "Contact readout 03 - ordering",
        "steps": [
          {
            "keyword": "Given",
            "text": "visible live contacts near at range 2 far at range 8 and destroyed wreck at range 1 in that roster order"
          },
          {
            "keyword": "When",
            "text": "the pilot requests contact brevity <brevity>",
            "parameters": [
              "brevity"
            ]
          },
          {
            "keyword": "Then",
            "text": "displayed contact order is <order> and ordinary heading is <heading>",
            "parameters": [
              "order",
              "heading"
            ]
          }
        ],
        "columns": [
          "brevity",
          "order",
          "heading"
        ]
      },
      {
        "name": "Contact readout 04 - status masking",
        "steps": [
          {
            "keyword": "Given",
            "text": "a same-team contact with primary visibility and terrain block <block>",
            "parameters": [
              "block"
            ]
          },
          {
            "keyword": "And",
            "text": "the contact is heated jellied burning and has active ECM and attached NARC"
          },
          {
            "keyword": "When",
            "text": "a brief contact list is requested"
          },
          {
            "keyword": "Then",
            "text": "the name is <name> apparent friend is <friend> and five status characters are <status>",
            "parameters": [
              "name",
              "friend",
              "status"
            ]
          }
        ],
        "columns": [
          "block",
          "name",
          "friend",
          "status"
        ]
      }
    ]
  },
  "controls": {
    "background": [
      {
        "keyword": "Given",
        "text": "a fresh sensor session with ready units and event time zero"
      }
    ],
    "scenarios": [
      {
        "name": "Sensor controls 01 - delayed selection",
        "steps": [
          {
            "keyword": "Given",
            "text": "visual sensors and a unit target lock with retained hex coordinates"
          },
          {
            "keyword": "When",
            "text": "the pilot requests sensors <request>",
            "parameters": [
              "request"
            ]
          },
          {
            "keyword": "And",
            "text": "the engine advances <seconds> seconds",
            "parameters": [
              "seconds"
            ]
          },
          {
            "keyword": "Then",
            "text": "current sensors are <current> wanted sensors are <wanted> and the unit target is <target>",
            "parameters": [
              "current",
              "wanted",
              "target"
            ]
          },
          {
            "keyword": "And",
            "text": "the hex coordinates and lock mode bits are unchanged"
          }
        ],
        "columns": [
          "request",
          "seconds",
          "current",
          "wanted",
          "target"
        ]
      },
      {
        "name": "Sensor controls 02 - replace pending",
        "steps": [
          {
            "keyword": "Given",
            "text": "a sensor change from VV to IE requested at time zero"
          },
          {
            "keyword": "When",
            "text": "the engine advances 3 seconds"
          },
          {
            "keyword": "And",
            "text": "the pilot requests sensors <request>",
            "parameters": [
              "request"
            ]
          },
          {
            "keyword": "And",
            "text": "the engine advances to time <time>",
            "parameters": [
              "time"
            ]
          },
          {
            "keyword": "Then",
            "text": "current sensors are <current> wanted sensors are <wanted> and the sensor deadline is <deadline>",
            "parameters": [
              "current",
              "wanted",
              "deadline"
            ]
          }
        ],
        "columns": [
          "request",
          "time",
          "current",
          "wanted",
          "deadline"
        ]
      },
      {
        "name": "Sensor controls 03 - light availability",
        "steps": [
          {
            "keyword": "Given",
            "text": "current sensors <pair> and map light 0",
            "parameters": [
              "pair"
            ]
          },
          {
            "keyword": "When",
            "text": "configured map light <light> is read by the normal time 25 map update",
            "parameters": [
              "light"
            ]
          },
          {
            "keyword": "Then",
            "text": "current sensors are <current> with no sensor change event created",
            "parameters": [
              "current"
            ]
          }
        ],
        "columns": [
          "pair",
          "light",
          "current"
        ]
      },
      {
        "name": "Sensor controls 04 - capability readout",
        "steps": [
          {
            "keyword": "Given",
            "text": "current sensors <pair> and map light 0",
            "parameters": [
              "pair"
            ]
          },
          {
            "keyword": "And",
            "text": "all equipment required by that sensor pair is installed"
          },
          {
            "keyword": "When",
            "text": "the pilot requests sensor readout <style>",
            "parameters": [
              "style"
            ]
          },
          {
            "keyword": "Then",
            "text": "the sensor name includes <name> and scanning description is <arc>",
            "parameters": [
              "name",
              "arc"
            ]
          },
          {
            "keyword": "And",
            "text": "blocker details are <details>",
            "parameters": [
              "details"
            ]
          }
        ],
        "columns": [
          "pair",
          "style",
          "name",
          "arc",
          "details"
        ]
      }
    ]
  },
  "detection": {
